{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Debug runner",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/runner.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/scripts"
      }
    }
  ]
}
